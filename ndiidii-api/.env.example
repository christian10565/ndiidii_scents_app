# ---- Server ----
PORT=3000
# Your React app's origin (comma-separate several). Needed for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# ---- Database (Supabase Postgres) ----
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Use the pooled ("Transaction pooler" / Supavisor) string if your host is IPv4-only.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres
DB_SSL=true
# true = TypeORM auto-creates/updates tables. Fine while building; switch to migrations before launch.
DB_SYNC=true

# ---- Google Sheets ----
GOOGLE_SHEET_ID=the_long_id_from_the_sheet_url
# Exact tab (worksheet) names, as they appear at the bottom of the sheet
PERFUME_TAB=Perfumes
OIL_TAB=Perfume Oils
GOOGLE_SERVICE_ACCOUNT_EMAIL=ndiidii-sheets@your-project.iam.gserviceaccount.com
# Paste the private_key from the JSON key file, on ONE line, keeping the \n characters, inside quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Sync ----
# Shared secret the Apps Script sends when the sheet is edited (make it long and random)
SYNC_SECRET=change-me-to-a-long-random-string
# Stock given to a NEW product when the sheet has no Stock value for it
DEFAULT_STOCK=0
