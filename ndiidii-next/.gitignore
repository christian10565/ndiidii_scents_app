# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# e2e test artifacts (screenshots)
scripts/*.png


# Zaoud catalog cache — re-fetchable via scripts/fetch-zaoud.mjs, don't commit (12MB)
data/zaoud-products.json

# Shopify supplier catalog caches — re-fetchable via scripts/fetch-shopify.mjs, don't commit
data/shopify-*.json
